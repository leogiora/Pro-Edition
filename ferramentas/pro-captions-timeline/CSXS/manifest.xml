<?xml version="1.0" encoding="UTF-8"?>
<!--
  Ajudante do Pro Captions no formato ANTIGO de plugin (CEP + ExtendScript).

  Existe por um motivo so: o UXP (formato do Pro Edition) nao cria faixa de
  legenda nem poe um .srt na timeline — conferido ate a tipagem 27.0.0-beta.57
  (2026-09-23). O ExtendScript tem Sequence.createCaptionTrack(), e e isso
  que a ponte chama. Quando a Adobe liberar isso no UXP, este ajudante morre.

  Nao aparece em Window > Extensions (sem <Menu>): o painel visivel saiu em
  2026-09-24, o Editar e o Pro Captions pedem direto a ponte.
-->
<ExtensionManifest Version="7.0" ExtensionBundleId="com.leogi.procaptions.timeline" ExtensionBundleVersion="1.1.0" ExtensionBundleName="Pro Captions Timeline" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <ExtensionList>
    <Extension Id="com.leogi.procaptions.timeline.ponte" Version="1.1.0" />
  </ExtensionList>
  <ExecutionEnvironment>
    <HostList>
      <Host Name="PPRO" Version="[22.0,99.9]" />
    </HostList>
    <LocaleList>
      <Locale Code="All" />
    </LocaleList>
    <RequiredRuntimeList>
      <RequiredRuntime Name="CSXS" Version="9.0" />
    </RequiredRuntimeList>
  </ExecutionEnvironment>
  <DispatchInfoList>
    <!--
      A ponte: sem janela, abre sozinha quando o Premiere abre e atende o
      pedido do Pro Edition (ver proCaptions_atenderPedido).
    -->
    <Extension Id="com.leogi.procaptions.timeline.ponte">
      <DispatchInfo>
        <Resources>
          <MainPath>./ponte.html</MainPath>
          <ScriptPath>./host.jsx</ScriptPath>
        </Resources>
        <Lifecycle>
          <AutoVisible>false</AutoVisible>
          <StartOn>
            <Event>com.adobe.csxs.events.ApplicationActivate</Event>
            <Event>applicationActivate</Event>
          </StartOn>
        </Lifecycle>
        <UI>
          <Type>Custom</Type>
          <Geometry>
            <Size>
              <Height>1</Height>
              <Width>1</Width>
            </Size>
          </Geometry>
        </UI>
      </DispatchInfo>
    </Extension>
  </DispatchInfoList>
</ExtensionManifest>
