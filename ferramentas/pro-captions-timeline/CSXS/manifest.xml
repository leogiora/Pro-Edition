<?xml version="1.0" encoding="UTF-8"?>
<!--
  Ajudante do Pro Captions no formato ANTIGO de plugin (CEP + ExtendScript).

  Existe por um motivo so: o UXP (formato do Pro Edition) nao cria faixa de
  legenda nem poe um .srt na timeline — conferido ate a tipagem 27.0.0-beta.57
  (2026-09-23). O ExtendScript tem Sequence.createCaptionTrack(), e e isso
  que este painel chama. Quando a Adobe liberar isso no UXP, este ajudante
  morre e o botao vai para o Pro Captions.
-->
<ExtensionManifest Version="7.0" ExtensionBundleId="com.leogi.procaptions.timeline" ExtensionBundleVersion="1.0.0" ExtensionBundleName="Pro Captions Timeline" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <ExtensionList>
    <Extension Id="com.leogi.procaptions.timeline.panel" Version="1.0.0" />
  </ExtensionList>
  <ExecutionEnvironment>
    <HostList>
      <Host Name="PPRO" Version="[22.0,99.9]" />
    </HostList>
    <LocaleList>
      <Locale Code="All" />
    </LocaleList>
    <RequiredRuntimeList>
      <RequiredRuntime Name="CSXS" Version="9.0" />
    </RequiredRuntimeList>
  </ExecutionEnvironment>
  <DispatchInfoList>
    <Extension Id="com.leogi.procaptions.timeline.panel">
      <DispatchInfo>
        <Resources>
          <MainPath>./index.html</MainPath>
          <ScriptPath>./host.jsx</ScriptPath>
        </Resources>
        <Lifecycle>
          <AutoVisible>true</AutoVisible>
        </Lifecycle>
        <UI>
          <Type>Panel</Type>
          <Menu>Pro Captions: Timeline</Menu>
          <Geometry>
            <Size>
              <Height>260</Height>
              <Width>320</Width>
            </Size>
            <MinSize>
              <Height>160</Height>
              <Width>220</Width>
            </MinSize>
          </Geometry>
        </UI>
      </DispatchInfo>
    </Extension>
  </DispatchInfoList>
</ExtensionManifest>
