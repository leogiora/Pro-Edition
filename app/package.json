{
  "name": "pro-edition-app",
  "productName": "Cutline",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Cutline fora do Premiere: a tela das ferramentas que editam no Premiere aberto.",
  "main": "dist/main.cjs",
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "npm run build && electron .",
    "check": "tsc --noEmit",
    "test": "node --test \"tests/*.test.ts\"",
    "verify": "npm run check && npm test && npm run build",
    "instalador": "npm run verify && node scripts/instalador.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.13.6",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.25.12",
    "typescript": "^5.9.3"
  },
  "build": {
    "appId": "com.leogi.proedition.app",
    "productName": "Cutline",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "scripts/icone.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "shortcutName": "Cutline"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "scripts/icone-mac.png",
      "category": "public.app-category.video",
      "identity": "-",
      "hardenedRuntime": false
    },
    "dmg": {
      "title": "Cutline"
    }
  }
}
